# ── Store identity ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CONTACT_EMAIL=hello@0xm4ngli.store
PRIVACY_EMAIL=privacy@0xm4ngli.store

# Complete these before taking real orders. They appear on the legal pages.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
COMPANY_NUMBER=
VAT_ID=

# ── Database ───────────────────────────────────────────────────────────────────
# Local development: a SQLite file. Production on Vercel MUST use Turso.
DATA_DIR=./data
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# On Vercel, set both TURSO_* variables. Without them the app refuses to start
# rather than silently losing orders in an ephemeral filesystem.

# ── Payments: bank transfer only ───────────────────────────────────────────────
# Optional overrides. The official account is published intentionally in
# config/donation.ts and DONATIONS.md so customers can verify it. Set these only
# if you need to override the official details at runtime. Never put card
# numbers, banking passwords or one-time codes in any file.
BANK_ACCOUNT_NAME=
BANK_IBAN=
BANK_BIC=
BANK_NAME=
BANK_COUNTRY=

# ── Runtime secrets ────────────────────────────────────────────────────────────
# 32+ random characters. Signs the guest cart cookie.
CART_SECRET=replace-with-a-long-random-string
# Optional; CART_SECRET is used first.
SESSION_SECRET=
# Bearer token for /api/admin/orders and /api/admin/price-sync.
ADMIN_TOKEN=
# Backwards-compatible fallback for the feed endpoint only.
ADMIN_SYNC_TOKEN=

# ── Shipping (cents, EUR) ──────────────────────────────────────────────────────
# Shipping is free for every order by default. Leave both at 0 for free tracked
# worldwide shipping. Set a flat rate above 0 only if you want to charge for it.
FLAT_SHIPPING_CENTS=0
FREE_SHIPPING_THRESHOLD_CENTS=0
# Delivery wording on product pages (business days).
DISPATCH_BUSINESS_DAYS=1
DELIVERY_MIN_BUSINESS_DAYS=3
DELIVERY_MAX_BUSINESS_DAYS=10
RETURNS_DAYS=14

# ── Authorised product feed ────────────────────────────────────────────────────
PRICE_FEED_URL=
PRICE_FEED_TOKEN=

# Real market price history via PricesAPI (https://pricesapi.io).
# A free key includes 3,000 one-time credits and needs no card.
PRICESAPI_KEY=
PRICE_MARKET=au
PRICE_HISTORY_DAYS=90

# ── Catalogue and price history ────────────────────────────────────────────────
# In production the starter catalogue is treated as live and synthetic price
# history is disabled by default. Set SEED_PRICE_HISTORY=true only for a
# non-production demo. CATALOG_IS_DEMO=true marks seeded products as demo and
# disables real orders for them.
CATALOG_IS_DEMO=
SEED_PRICE_HISTORY=
# Only set true if you understand that the seeded catalogue is not verified
# stock and you want to accept real bank transfers for it.
ALLOW_DEMO_CATALOG_ORDERS=false
# Show the demo/illustrative notice in the footer.
NEXT_PUBLIC_DEMO_CATALOG=false

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# If omitted, development logs emails to the server console; production logs a warning.
RESEND_API_KEY=
EMAIL_FROM="0xm4ngli <hello@0xm4ngli.store>"

# ── Images ─────────────────────────────────────────────────────────────────────
# Extra Next.js image hosts (comma-separated) allowed to serve product images.
IMAGE_HOSTS=

# Vercel Cron
CRON_SECRET=
